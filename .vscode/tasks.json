{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build this presentation",
      "detail": "Build main.tex in the repo root",
      "type": "shell",
      "windows": { "command": "powershell", "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/build.ps1"] },
      "osx":     { "command": "bash", "args": ["${workspaceFolder}/scripts/build.sh"] },
      "linux":   { "command": "bash", "args": ["${workspaceFolder}/scripts/build.sh"] },
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Build everything",
      "detail": "This presentation plus any deck in a subfolder (showcase)",
      "type": "shell",
      "windows": { "command": "powershell", "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/build.ps1", "-All"] },
      "osx":     { "command": "bash", "args": ["${workspaceFolder}/scripts/build.sh", "-a"] },
      "linux":   { "command": "bash", "args": ["${workspaceFolder}/scripts/build.sh", "-a"] },
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Build with pdfLaTeX (faster, no Thai)",
      "detail": "Force pdfLaTeX. Thai falls back to Garuda for the whole deck.",
      "type": "shell",
      "windows": { "command": "powershell", "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/build.ps1", "-Engine", "pdf"] },
      "osx":     { "command": "bash", "args": ["${workspaceFolder}/scripts/build.sh", "-e", "pdf"] },
      "linux":   { "command": "bash", "args": ["${workspaceFolder}/scripts/build.sh", "-e", "pdf"] },
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Watch",
      "detail": "Rebuild automatically on every save (Ctrl+C to stop)",
      "type": "shell",
      "isBackground": true,
      "windows": { "command": "powershell", "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/build.ps1", "-Watch"] },
      "osx":     { "command": "bash", "args": ["${workspaceFolder}/scripts/build.sh", "-w"] },
      "linux":   { "command": "bash", "args": ["${workspaceFolder}/scripts/build.sh", "-w"] },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Clean",
      "type": "shell",
      "windows": { "command": "powershell", "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/clean.ps1"] },
      "osx":     { "command": "bash", "args": ["${workspaceFolder}/scripts/clean.sh"] },
      "linux":   { "command": "bash", "args": ["${workspaceFolder}/scripts/clean.sh"] },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
