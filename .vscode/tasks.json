{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build this deck",
      "detail": "Build the deck containing the file you are editing",
      "type": "shell",
      "windows": { "command": "powershell", "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/build.ps1", "-Deck", "${relativeFileDirname}"] },
      "osx":     { "command": "bash", "args": ["${workspaceFolder}/scripts/build.sh", "-d", "${relativeFileDirname}"] },
      "linux":   { "command": "bash", "args": ["${workspaceFolder}/scripts/build.sh", "-d", "${relativeFileDirname}"] },
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Build all decks",
      "type": "shell",
      "windows": { "command": "powershell", "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/build.ps1"] },
      "osx":     { "command": "bash", "args": ["${workspaceFolder}/scripts/build.sh"] },
      "linux":   { "command": "bash", "args": ["${workspaceFolder}/scripts/build.sh"] },
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Build this deck (XeLaTeX)",
      "detail": "Force XeLaTeX - needed for real Sarabun in Thai decks",
      "type": "shell",
      "windows": { "command": "powershell", "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/build.ps1", "-Deck", "${relativeFileDirname}", "-Engine", "xe"] },
      "osx":     { "command": "bash", "args": ["${workspaceFolder}/scripts/build.sh", "-d", "${relativeFileDirname}", "-e", "xe"] },
      "linux":   { "command": "bash", "args": ["${workspaceFolder}/scripts/build.sh", "-d", "${relativeFileDirname}", "-e", "xe"] },
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Watch this deck",
      "detail": "Rebuild automatically on every save (Ctrl+C to stop)",
      "type": "shell",
      "isBackground": true,
      "windows": { "command": "powershell", "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/build.ps1", "-Deck", "${relativeFileDirname}", "-Watch"] },
      "osx":     { "command": "bash", "args": ["${workspaceFolder}/scripts/build.sh", "-d", "${relativeFileDirname}", "-w"] },
      "linux":   { "command": "bash", "args": ["${workspaceFolder}/scripts/build.sh", "-d", "${relativeFileDirname}", "-w"] },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Clean",
      "type": "shell",
      "windows": { "command": "powershell", "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/clean.ps1"] },
      "osx":     { "command": "bash", "args": ["${workspaceFolder}/scripts/clean.sh"] },
      "linux":   { "command": "bash", "args": ["${workspaceFolder}/scripts/clean.sh"] },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "New deck",
      "detail": "Prompts for a name, then scaffolds decks/<name>",
      "type": "shell",
      "windows": { "command": "powershell", "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/new-deck.ps1", "-Name", "${input:deckName}"] },
      "osx":     { "command": "bash", "args": ["${workspaceFolder}/scripts/new-deck.sh", "-n", "${input:deckName}"] },
      "linux":   { "command": "bash", "args": ["${workspaceFolder}/scripts/new-deck.sh", "-n", "${input:deckName}"] },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Export this deck (standalone)",
      "detail": "Bundle the deck you are editing, with theme and fonts, into export/<name>",
      "type": "shell",
      "windows": { "command": "powershell", "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/export-deck.ps1", "-Deck", "${relativeFileDirname}", "-Force"] },
      "osx":     { "command": "bash", "args": ["${workspaceFolder}/scripts/export-deck.sh", "-d", "${relativeFileDirname}", "-f"] },
      "linux":   { "command": "bash", "args": ["${workspaceFolder}/scripts/export-deck.sh", "-d", "${relativeFileDirname}", "-f"] },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "deckName",
      "type": "promptString",
      "description": "Folder name for the new deck (e.g. jcsse-2026)"
    }
  ]
}
