% ============================================================================
%  beamerthemedeck.sty  --  master theme file
% ----------------------------------------------------------------------------
%  Loaded by:   \usetheme{deck}
%  which LaTeX expands to:  \usepackage{beamerthemedeck}
%
%  This master file does nothing itself except load the four parts a beamer
%  theme is made of:
%      color  -- the palette
%      font   -- typefaces and sizes
%      inner  -- what is INSIDE the slide (title page, blocks, bullets)
%      outer  -- what is AROUND the edge (title bar, footer, page numbers)
%
%  To change how slides look, edit those files -- not this one.
% ============================================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemedeck}[2026/08/15 v1.0 Beamer beamer theme]

% ---------------------------------------------------------------------------
%  HOW THIS FILE GETS FOUND
%
%  Every deck's main.tex opens with
%      \providecommand{\deckroot}{../../}
%      \makeatletter \edef\input@path{{\deckroot theme/}{\deckroot preamble/}}
%      \makeatother
%  which puts this folder on LaTeX's search path. That is all \usetheme{deck}
%  needs -- it works under a bare `pdflatex main.tex`, under TeXstudio, under
%  latexmk and on Overleaf alike, with no TEXINPUTS and no build script.
%
%  Because \input@path is still in force here, the four \use...theme lines
%  below find their files by the same route. Nothing else to configure.
% ---------------------------------------------------------------------------

\mode<presentation>

\usecolortheme{deck}
\usefonttheme{deck}
\useinnertheme{deck}
\useoutertheme{deck}

\mode<all>
\endinput
