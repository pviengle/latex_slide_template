% ============================================================================
%  beamerinnerthemedeck.sty  --  everything INSIDE the slide
% ----------------------------------------------------------------------------
%  Title page layout, section divider slides, blocks, bullet markers.
% ============================================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerinnerthemedeck}[2026/08/15 v1.0 Beamer inner]

\mode<presentation>
\RequirePackage{tikz}

% ---------------------------------------------------------------------------
%  Optional title-page logo, bottom-right in the white band. Set it in your
%  deck with:
%      \decklogo{\includegraphics[height=6mm]{path/to/logo.pdf}}
%  The band is 0.1\paperheight -- 9mm on a 16:9 slide -- so keep it under that.
%  If never set, nothing is drawn and no space is reserved.
% ---------------------------------------------------------------------------
\newcommand{\decklogocontent}{}
\newcommand{\decklogo}[1]{\renewcommand{\decklogocontent}{#1}}

% ---------------------------------------------------------------------------
%  Optional FOOTER logo (bottom-right placement only). Empty by default, so
%  nothing is drawn and the slot reserves no visible space. To use it:
%      \deckfooterlogo{\includegraphics[height=5mm]{path/to/logo.pdf}}
%  It sits in the footer between the author and the slide number, with equal
%  space either side. Placement scaffold only -- point it at your own logo.
% ---------------------------------------------------------------------------
\newcommand{\deckfooterlogocontent}{}
\newcommand{\deckfooterlogo}[1]{\renewcommand{\deckfooterlogocontent}{#1}}

% ---------------------------------------------------------------------------
%  TITLE PAGE
% ---------------------------------------------------------------------------
%  Full-bleed orange cover with white text and a white vertical bar to the
%  left of the title, matching the pptx cover. The orange is painted with a
%  page-anchored overlay so it fills edge to edge, ignoring text margins.
%
%  \deck@vcentre, not \vfill, above and below the title block. The class
%  option `t' adds a \vfill of beamer's own under every frame body, which
%  outvotes one \vfill above the block two to one and lifts the cover title
%  towards the top. A filll outranks beamer's fill entirely, so the block is
%  centred the same with or without `t'.
\newcommand{\deck@vcentre}{\vskip 0pt plus 1filll\relax}
\defbeamertemplate*{title page}{deck}[1][]{%
  \begin{tikzpicture}[remember picture, overlay]
    % Orange cover, with a white band across the bottom (pptx cover).
    \fill[BrandAccent]
      (current page.south west) rectangle (current page.north east);
    \fill[BrandPaper]
      (current page.south west)
      rectangle ([yshift=0.1\paperheight]current page.south east);
    % Logo placement in the white band, bottom-right (empty by default).
    \ifx\decklogocontent\empty\else
      \node[anchor=east, inner sep=0pt]
        at ([xshift=-\beamer@rightmargin, yshift=0.05\paperheight]current page.south east)
        {\decklogocontent};
    \fi
  \end{tikzpicture}%
  \deck@vcentre
  \begingroup
    \raggedright
    % White vertical bar, then the title block -- everything in white.
    \noindent{\color{BrandPaper}\vrule width 3pt}\hspace{4mm}%
    \begin{minipage}[c]{\dimexpr\paperwidth-\beamer@leftmargin-\beamer@rightmargin-8mm\relax}
      \color{BrandPaper}%
      {\usebeamerfont{title}\inserttitle\par}
      \ifx\insertsubtitle\empty\else
        \vspace{1.5mm}
        {\usebeamerfont{subtitle}\insertsubtitle\par}
      \fi
      \vspace{7mm}
      {\usebeamerfont{author}\insertauthor\par}
      \ifx\insertinstitute\empty\else
        \vspace{1mm}
        {\usebeamerfont{institute}\insertinstitute\par}
      \fi
      \vspace{4mm}
      {\usebeamerfont{date}\insertdate\par}
    \end{minipage}%
  \endgroup
  \deck@vcentre
  % Keep the title block clear of the bottom band.
  \vskip 0.12\paperheight
}

% ---------------------------------------------------------------------------
%  SECTION DIVIDER
%  Auto-inserted before each \section -- see the hook at the bottom.
% ---------------------------------------------------------------------------
\defbeamertemplate*{section page}{deck}[1][]{%
  \deck@vcentre   % centred with or without `t' -- see TITLE PAGE
  \begingroup
    \raggedright
    {\usebeamercolor[bg]{section number}%
     \begin{tikzpicture}
       \node[fill=BrandAccent, text=BrandPaper, rounded corners=1.2pt,
             inner sep=4pt, minimum width=9mm, align=center]
            {\usebeamerfont{section number}\insertsectionnumber};
     \end{tikzpicture}}\par
    \vspace{3mm}
    {\usebeamerfont{section title}\usebeamercolor[fg]{section title}%
     \insertsectionhead\par}
    \vspace{2mm}
    {\color{BrandRule}\rule{\textwidth}{0.6pt}}
  \endgroup
  \deck@vcentre
}

% ---------------------------------------------------------------------------
%  BLOCKS  --  flat, with a coloured title strip and a tinted body
% ---------------------------------------------------------------------------
\setbeamertemplate{block begin}{%
  \setlength{\parskip}{0pt}
  \begin{beamercolorbox}[colsep*=0ex, leftskip=1.4ex, rightskip=1.4ex,
                         dp=0.7ex, ht=2.4ex]{block title}
    \usebeamerfont{block title}\insertblocktitle
  \end{beamercolorbox}
  \nointerlineskip
  \begin{beamercolorbox}[colsep*=0ex, leftskip=1.4ex, rightskip=1.4ex,
                         dp=1.2ex, vmode]{block body}
    \vspace{0.6ex}
}
\setbeamertemplate{block end}{\end{beamercolorbox}\vspace{1ex}}

\setbeamertemplate{block example begin}{%
  \setlength{\parskip}{0pt}
  \begin{beamercolorbox}[colsep*=0ex, leftskip=1.4ex, rightskip=1.4ex,
                         dp=0.7ex, ht=2.4ex]{block title example}
    \usebeamerfont{block title}\insertblocktitle
  \end{beamercolorbox}
  \nointerlineskip
  \begin{beamercolorbox}[colsep*=0ex, leftskip=1.4ex, rightskip=1.4ex,
                         dp=1.2ex, vmode]{block body example}
    \vspace{0.6ex}
}
\setbeamertemplate{block example end}{\end{beamercolorbox}\vspace{1ex}}

\setbeamertemplate{block alerted begin}{%
  \setlength{\parskip}{0pt}
  \begin{beamercolorbox}[colsep*=0ex, leftskip=1.4ex, rightskip=1.4ex,
                         dp=0.7ex, ht=2.4ex]{block title alerted}
    \usebeamerfont{block title}\insertblocktitle
  \end{beamercolorbox}
  \nointerlineskip
  \begin{beamercolorbox}[colsep*=0ex, leftskip=1.4ex, rightskip=1.4ex,
                         dp=1.2ex, vmode]{block body alerted}
    \vspace{0.6ex}
}
\setbeamertemplate{block alerted end}{\end{beamercolorbox}\vspace{1ex}}

% ---------------------------------------------------------------------------
%  LIST MARKERS  --  small squares rather than beamer's default triangles
% ---------------------------------------------------------------------------
\setbeamertemplate{itemize item}      {\raisebox{0.15ex}{\rule{1.1ex}{1.1ex}}}
\setbeamertemplate{itemize subitem}   {\raisebox{0.2ex}{\rule{0.85ex}{0.85ex}}}
\setbeamertemplate{itemize subsubitem}{\raisebox{0.25ex}{\rule{0.6ex}{0.6ex}}}
\setbeamertemplate{enumerate item}    {\insertenumlabel.}
\setbeamertemplate{enumerate subitem} {\insertenumlabel.\insertsubenumlabel}

% Slightly roomier lists than beamer's default -- slides need the air.
\setlength{\leftmargini}{1.6em}
\setlength{\leftmarginii}{1.4em}

% ---------------------------------------------------------------------------
%  TABLE OF CONTENTS
% ---------------------------------------------------------------------------
\setbeamertemplate{section in toc}{%
  \leavevmode\leftskip=0pt%
  {\color{BrandAccent}\rule[0.25ex]{0.9ex}{0.9ex}}~\inserttocsection\par%
}
\setbeamertemplate{subsection in toc}{%
  \leavevmode\leftskip=2.2em%
  \inserttocsubsection\par%
}

% ---------------------------------------------------------------------------
%  CAPTIONS  --  "Figure 1: ..." without beamer's default centring
% ---------------------------------------------------------------------------
\setbeamertemplate{caption}[numbered]
\setbeamertemplate{caption label separator}{: }

\mode<all>
\endinput
