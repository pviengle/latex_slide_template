% ============================================================================
%  beamerouterthemedeck.sty  --  everything AROUND the slide edge
% ----------------------------------------------------------------------------
%  Frame title bar, footer, slide numbers, progress bar.
% ============================================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerouterthemedeck}[2026/08/15 v1.0 Beamer outer]

\mode<presentation>
\RequirePackage{pgfmath}
\RequirePackage{tikz}   % right-edge strip is drawn as a page-anchored overlay

% ---------------------------------------------------------------------------
%  Theme options
%     noprogressbar  -- hide the thin progress bar along the bottom
%     nofooter       -- hide the footer line entirely
%  Used as:  \usetheme[noprogressbar]{deck}
% ---------------------------------------------------------------------------
\newif\ifdeck@progressbar \deck@progressbartrue
\newif\ifdeck@footer      \deck@footertrue

\DeclareOptionBeamer{noprogressbar}{\deck@progressbarfalse}
\DeclareOptionBeamer{nofooter}{\deck@footerfalse}
\ProcessOptionsBeamer

% ---------------------------------------------------------------------------
%  Beamer's navigation icons are clutter on a projector. Off by default.
% ---------------------------------------------------------------------------
\setbeamertemplate{navigation symbols}{}

% ---------------------------------------------------------------------------
%  THE GAP BETWEEN THE FRAME TITLE AND THE SLIDE BODY
%
%  Adjustable from your deck, after \usetheme{deck}:
%      \decktitlegap{0.4ex}     tighter -- body starts closer to the title
%      \decktitlegap{1.2ex}     the default
%
%  If the body still sits too low, this is usually not the culprit: beamer
%  centres frame content vertically unless the document class is given the
%  `t' option. See the tuning block in main.tex.
% ---------------------------------------------------------------------------
\newlength{\deck@titlegap}
\setlength{\deck@titlegap}{1.2ex}
\newcommand{\decktitlegap}[1]{\setlength{\deck@titlegap}{#1}}

% ---------------------------------------------------------------------------
%  FRAME TITLE
%  An orange bar to the left of the title, an optional subtitle, and the
%  segmented strip down the right edge of the slide.
% ---------------------------------------------------------------------------
\setbeamertemplate{frametitle}{%
  \nointerlineskip
  \begin{beamercolorbox}[wd=\paperwidth, leftskip=\beamer@leftmargin,
                         rightskip=\beamer@rightmargin,
                         ht=3.2ex, dp=1.6ex]{frametitle}
    % --- Right-edge segmented strip (orange / gold / gray) ----------------
    %  Page-anchored overlay (zero size here), so it lands only on frames
    %  that have a frame title -- content slides, not title/section pages.
    %  Segment depths are fractions of page height, down from the top-right.
    \begin{tikzpicture}[remember picture, overlay]
      \fill[BrandAccent]
        ([xshift=-6pt]current page.north east)
        rectangle ([yshift=-0.42\paperheight]current page.north east);
      \fill[BrandGold]
        ([xshift=-6pt, yshift=-0.42\paperheight]current page.north east)
        rectangle ([yshift=-0.50\paperheight]current page.north east);
      \fill[BrandStripGray]
        ([xshift=-6pt, yshift=-0.50\paperheight]current page.north east)
        rectangle ([yshift=-0.58\paperheight]current page.north east);
    \end{tikzpicture}%
    % Left vertical orange bar (replaces the old underline rule).
    {\color{BrandAccent}\vrule width 3pt}\hspace{2.5mm}%
    \usebeamerfont{frametitle}\insertframetitle%
    \ifx\insertframesubtitle\empty\else
      \\[-0.4ex]\hspace*{5.5mm}{\usebeamerfont{framesubtitle}%
                 \usebeamercolor[fg]{framesubtitle}\insertframesubtitle}%
    \fi
  \end{beamercolorbox}%
  \vspace{\deck@titlegap}
}

% ---------------------------------------------------------------------------
%  PROGRESS BAR
%  Drawn as two overlapping rules: a full-width track, with the filled
%  portion laid on top of it. \rlap puts the track down without advancing
%  the cursor, so the fill starts at the same x position.
%
%  On the very first compiler run \inserttotalframenumber is 0, which would
%  be a division by zero -- hence the guard. latexmk reruns and it settles.
% ---------------------------------------------------------------------------
\newcommand{\deck@progressline}{%
  \ifnum\inserttotalframenumber>0\relax
    \pgfmathsetmacro{\deck@frac}{\insertframenumber/\inserttotalframenumber}%
    \rlap{\color{BrandRule}\rule{\paperwidth}{1pt}}%
    {\color{BrandAccent}\rule{\deck@frac\paperwidth}{1pt}}%
  \else
    \rlap{\color{BrandRule}\rule{\paperwidth}{1pt}}\hspace*{\paperwidth}%
  \fi
}

% ---------------------------------------------------------------------------
%  FOOTER
%  Short title, short author and slide N / total, spread evenly across the
%  slide. The optional footer logo (\deckfooterlogo) joins them, between the
%  author and the slide number.
% ---------------------------------------------------------------------------
\ifdeck@footer
  \setbeamertemplate{footline}{%
    \ifdeck@progressbar
      \nointerlineskip
      \leavevmode\deck@progressline\par
    \fi
    \nointerlineskip
    \begin{beamercolorbox}[wd=\paperwidth, ht=0.075\paperheight, dp=1.4ex,
                           leftskip=\beamer@leftmargin,
                           rightskip=\beamer@rightmargin]{footline}
      \usebeamerfont{footline}%
      \insertshorttitle%
      \hfill
      \insertshortauthor%
      \hfill
      % Bottom-right logo slot (empty by default -- see \deckfooterlogo).
      \ifx\deckfooterlogocontent\empty\else
        \raisebox{0ex}{\deckfooterlogocontent}\hspace{0mm}%
        \hfill
      \fi
      \insertframenumber\,/\,\inserttotalframenumber%
    \end{beamercolorbox}%
  }
\else
  \setbeamertemplate{footline}{}
\fi

% ---------------------------------------------------------------------------
%  MARGINS  --  a touch wider than beamer's default; 16:9 slides can take it
% ---------------------------------------------------------------------------
\setbeamersize{text margin left=8mm, text margin right=8mm}

\mode<all>
\endinput
