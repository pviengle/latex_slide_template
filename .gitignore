# NOTE: git does NOT support comments at the end of a rule. A "#" partway
# through a line is part of the pattern, not a comment, and quietly stops the
# rule from matching anything. Every comment here is on its own line.

# ---- Build output -----------------------------------------------------------
build/

# latexmk intermediates, for the root deck and any deck in a subfolder
out/
*/out/

*.pdf

# keep the logo -- it is a source asset, not build output
!theme/assets/*.pdf

# ---- LaTeX intermediates ----------------------------------------------------
*.aux
*.log
*.out
*.toc
*.nav
*.snm
*.vrb
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.xdv
*.dvi

# uncompressed synctex, if an editor asks for it
*.synctex

# ---- Bibliography (biblatex + biber) ---------------------------------------
*.bbl
*.blg
*.bcf
*.run.xml
*.bib.bak

# ---- listings / minted / misc ----------------------------------------------
*.lol
*.lof
*.lot
_minted*/
*.pyg

# ---- Editor / OS ------------------------------------------------------------
# TeXstudio session files
*.txss2
*.txss

.DS_Store
Thumbs.db
*.swp
*~
